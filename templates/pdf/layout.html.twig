<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <style>
    @page {
      margin: 22mm 15mm 20mm 15mm;
    }
    body {
      font-family: "DejaVu Sans", sans-serif;
      font-size: 11px;
      color: #1a1a1a;
    }
    header {
      position: fixed;
      top: -18mm;
      left: 0;
      right: 0;
      height: 16mm;
      border-bottom: 1px solid #ddd;
      padding-bottom: 4px;
    }
    /* Dompdf has no flexbox support, so the header layout is a table instead. */
    header table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 0;
    }
    header td {
      border: none;
      padding: 0;
      vertical-align: middle;
    }
    header .logo-cell {
      width: 42mm;
    }
    header img {
      max-height: 14mm;
      max-width: 40mm;
    }
    header .club-name {
      font-size: 14px;
      font-weight: bold;
    }
    header .club-address {
      font-size: 9px;
      color: #666;
    }
    header .date-cell {
      width: 25mm;
      text-align: right;
    }
    footer {
      position: fixed;
      bottom: -16mm;
      left: 0;
      right: 0;
      height: 12mm;
      font-size: 9px;
      color: #666;
      text-align: center;
      border-top: 1px solid #ddd;
      padding-top: 4px;
    }
    h1 {
      font-size: 18px;
      margin-bottom: 2px;
    }
    h2 {
      font-size: 13px;
      color: #444;
      margin-top: 0;
      font-weight: normal;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 12px;
    }
    th, td {
      border: 1px solid #ccc;
      padding: 4px 6px;
      text-align: left;
    }
    th {
      background-color: #f2f2f2;
    }
    .text-right {
      text-align: right;
    }
    tfoot td {
      font-weight: bold;
      background-color: #f8f8f8;
    }
  </style>
</head>
<body>
{% set clubAddressLine = [club.address, [club.zipCode, club.city]|filter(v => v)|join(' ')]|filter(v => v)|join(', ') %}

<header>
  <table>
    <tr>
      <td class="logo-cell">
        {% if logoBase64 %}<img src="{{ logoBase64 }}" alt="Logo">{% endif %}
      </td>
      <td>
        <div class="club-name">{{ club.name }}</div>
        {% if clubAddressLine %}<div class="club-address">{{ clubAddressLine }}</div>{% endif %}
      </td>
      <td class="date-cell">{{ 'now'|date('d/m/Y') }}</td>
    </tr>
  </table>
</header>

{% block content %}{% endblock %}

<footer>
  {{ club.name }}{% if clubAddressLine %} — {{ clubAddressLine }}{% endif %}
  {%- if club.siret %} — SIRET : {{ club.siret }}{% endif %}
  {%- if club.vat %} — TVA : {{ club.vat }}{% endif %}
</footer>
</body>
</html>
