{% extends 'email/layout.html.twig' %}

{% block header_before %}
    {% if unsubscribe_url is defined %}
        <tr class="center">
            <td style="padding-top: 12px; font-size: 10px;">
                <a href="{{ unsubscribe_url }}" target="_blank" style="color: #909090">Se désabonner</a>
            </td>
        </tr>
    {% endif %}
{% endblock %}

{% block content %}
    {{ content }}
{% endblock %}

{% block footer_left %}
    <p>Cet email vous a été envoyé de la part de <b>{{ club.name }}</b> en utilisant la plateforme <a href="{{ frontend_url }}">Narvik</a></p>
    {% if isNewsletter and unsubscribe_url is defined %}
        <p>Si vous ne souhaitez plus recevoir la newsletter de cette association, vous pouvez vous désabonner en cliquant sur le lien suivant : <a href="{{ unsubscribe_url }}">{{ unsubscribe_url }}</a></p>
    {% endif %}
{% endblock %}
