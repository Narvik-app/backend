{
    "name": "benoit-vignal/narvik-back",
    "version": "3.13.1",
    "type": "project",
    "license": "GNU AGPLv3",
    "description": "App to manage multiple french association, especially sporting associations",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-gd": "*",
        "ext-gmp": "*",
        "ext-iconv": "*",
        "ext-zip": "*",
        "api-platform/doctrine-orm": "^4.0",
        "api-platform/ramsey-uuid": "^4.0",
        "api-platform/symfony": "^4.0",
        "doctrine/doctrine-bundle": "^3.1",
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.3",
        "league/csv": "^9.16",
        "league/oauth2-server-bundle": "^1.0",
        "nelmio/cors-bundle": "^2.4",
        "phpdocumentor/reflection-docblock": "^5.6",
        "phpoffice/phpspreadsheet": "^5.3",
        "phpstan/phpdoc-parser": "^2.0",
        "ramsey/uuid-doctrine": "^2.1",
        "runtime/frankenphp-symfony": "^0.2.0",
        "symfony/asset": "8.0.*",
        "symfony/console": "8.0.*",
        "symfony/doctrine-messenger": "8.0.*",
        "symfony/dotenv": "8.0.*",
        "symfony/expression-language": "8.0.*",
        "symfony/filesystem": "8.0.*",
        "symfony/finder": "8.0.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "8.0.*",
        "symfony/http-client": "8.0.*",
        "symfony/lock": "8.0.*",
        "symfony/mailer": "8.0.*",
        "symfony/messenger": "8.0.*",
        "symfony/mime": "8.0.*",
        "symfony/monolog-bundle": "^4.0",
        "symfony/property-access": "8.0.*",
        "symfony/property-info": "8.0.*",
        "symfony/rate-limiter": "8.0.*",
        "symfony/runtime": "7.4.*",
        "symfony/security-bundle": "8.0.*",
        "symfony/serializer": "8.0.*",
        "symfony/twig-bridge": "8.0.*",
        "symfony/twig-bundle": "8.0.*",
        "symfony/validator": "8.0.*",
        "symfony/yaml": "8.0.*",
        "twig/cssinliner-extra": "^3.11",
        "twig/extra-bundle": "^3.11",
        "twig/twig": "^3.15",
        "zenstruck/foundry": "^2.8"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.2",
        "justinrainbow/json-schema": "^6.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpunit/phpunit": "^12",
        "rector/rector": "^2.0",
        "symfony/browser-kit": "8.0.*",
        "symfony/css-selector": "7.4.*",
        "symfony/debug-bundle": "8.0.*",
        "symfony/maker-bundle": "^1.51",
        "symfony/phpunit-bridge": "^8.0",
        "symfony/stopwatch": "7.4.*",
        "symfony/web-profiler-bundle": "8.0.*",
        "zenstruck/messenger-test": "^1.11"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "reload-db": [
            "php bin/console doctrine:database:drop --force",
            "php bin/console doctrine:database:create",
            "@reload-fixture"
        ],
        "reload-schema": [
            "php bin/console doctrine:schema:drop --force",
            "php bin/console doctrine:schema:update --complete --force"
        ],
        "reload-fixture": [
            "@reload-schema",
            "php bin/console doctrine:fixtures:load -q"
        ],
        "reload-test": [
            "php bin/console --env=test doctrine:schema:drop --force",
            "php bin/console --env=test doctrine:schema:update --complete --force",
            "php bin/console --env=test doctrine:fixtures:load -q"
        ],
        "test": [
            "bin/phpunit"
        ],
        "ci-test": [
            "Composer\\Config::disableProcessTimeout",
            "set -o pipefail; XDEBUG_MODE=coverage bin/phpunit --coverage-clover coverage.xml --log-junit junit.xml --coverage-html var/coverage 2>&1 | tee var/phpunit-output.log"
        ],
        "test-with-coverage": [
            "Composer\\Config::disableProcessTimeout",
            "XDEBUG_MODE=coverage bin/phpunit --coverage-html=tests/coverage/html"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*",
            "docker": true
        }
    }
}
