							"const currentTime = Date.now();",
							"",
							"",
							"if (pm.environment.get(\"token_expire\") <= currentTime) {",
							"    console.log(\"Retrieving new access token\")",
							"    pm.sendRequest({",
							"        url: `${pm.collectionVariables.get(\"baseUrl\")}/token`,",
							"        method: 'POST',",
							"        header: {",
							"            'Authorization': pm.globals.get('auth'),",
							"            'Content-Type': 'application/x-www-form-urlencoded',",
							"            'Accept': 'application/json'",
							"        },",
							"        body: {",
							"            mode: 'raw',",
							"            raw: `grant_type=refresh_token&refresh_token=${pm.environment.get('refresh_token')}`",
							"        }",
							"    }, function (err, response) {",
							"        if (err) {",
							"            console.error(\"Fail to refresh the token\")",
							"            throw err",
							"        }",
							"        console.log(response.json());",
							"        var jsonData = response.json();",
							"",
							"        if (jsonData.error) {",
							"            console.error(jsonData);",
							"            throw Error(`FAILED TO ACQUIRE ACCESS TOKEN.  ${jsonData.error_description}`)",
							"        }",
							"",
							"        pm.environment.set(\"access_token\", jsonData.access_token);",
							"        pm.environment.set(\"refresh_token\", jsonData.refresh_token);",
							"        pm.environment.set(\"token_expire\", currentTime + (jsonData.expires_in * 1000));",
							"    });",
							"}"
						]
					}
